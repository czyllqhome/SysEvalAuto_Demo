# Application-specific runtime configuration.
SYSEVAL_DATABASE_URL=postgresql+psycopg://syseval:change-this-local-password@db:5432/syseval
POSTGRES_PASSWORD=change-this-local-password
SYSEVAL_EMBEDDED_WORKER=false
SYSEVAL_AUTO_CREATE=false
# Set true only when serving through HTTPS.
SYSEVAL_COOKIE_SECURE=false
SYSEVAL_PUBLIC_ORIGIN=http://127.0.0.1:8080
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-flash
OPENROUTER_PROVIDERS=alibaba
OPENROUTER_ZDR=false
SYSEVAL_MAX_OUTPUT_TOKENS=12000
SYSEVAL_SYSTEM_TOKEN_BUDGET=500000
# Optional; requires model/provider support. Must be below the total output cap.
OPENROUTER_REASONING_TOKENS=
